{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "localagents",
    "compatibility_date": "2026-10-30",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./worker/index.ts",
    "upload_source_maps": true,
    "observability": { "enabled": true },
    // 인계 파일은 워커가 직접 다루지 않는다. 워커는 SigV4 서명만 하고
    // 데몬이 presigned URL 로 R2 에 직행한다. 그래서 R2 바인딩이 필요 없다.
    // 버킷 이름은 var 하나로 결정한다 (dev/prod 는 이 값만 다르다).
    "vars": {
        "R2_ACCOUNT_ID": "9ab5fff4a2988fde61db5d5705759000",
        "HANDOFFS_BUCKET_NAME": "local-agents"
    },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "html_handling": "drop-trailing-slash",
        "run_worker_first": [
            "/api/*",
            "/sitemap.xml",
            "/robots.txt",
            "/auth/sign-in",
            "/sessions",
            "/sessions/*",
            "/devices",
            "/devices/*",
            "/profile",
            "/profile/*",
            "/billing",
            "/billing/*",
            "/device",
            "/device/*"
        ]
    }
}
