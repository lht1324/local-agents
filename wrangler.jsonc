{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "localagents",
    "compatibility_date": "2026-10-30",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./worker/index.ts",
    "upload_source_maps": true,
    "observability": { "enabled": true },
    // R2 바인딩. 서명 자격증명이 없을 때의 중계 경로가 쓴다.
    // 서명 자격증명(R2_ACCESS_KEY_ID)을 넣으면 presigned URL 로 전환되어 이 바인딩은 쓰이지 않는다.
    "r2_buckets": [
        {
            "binding": "HANDOFFS_BUCKET",
            "bucket_name": "local-agents"
        }
    ],
    // 버킷 이름은 var 하나로 결정한다 (dev/prod 는 이 값만 다르다).
    "vars": {
        "R2_ACCOUNT_ID": "9ab5fff4a2988fde61db5d5705759000",
        "HANDOFFS_BUCKET_NAME": "local-agents"
    },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "html_handling": "drop-trailing-slash",
        "run_worker_first": [
            "/api/*",
            "/sitemap.xml",
            "/robots.txt",
            "/auth/sign-in",
            "/sessions",
            "/sessions/*",
            "/devices",
            "/devices/*",
            "/profile",
            "/profile/*",
            "/billing",
            "/billing/*",
            "/device",
            "/device/*"
        ]
    }
}
